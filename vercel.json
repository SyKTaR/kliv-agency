{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/pages/index.html"
    },
    {
      "source": "/agence-web-roissy-en-brie",
      "destination": "/pages/agence-web-roissy-en-brie.html"
    },
    {
      "source": "/agence-web-seine-et-marne",
      "destination": "/pages/agence-web-seine-et-marne.html"
    },
    {
      "source": "/guides",
      "destination": "/pages/guides/index.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/pages/guides/:slug.html"
    },
    {
      "source": "/contact",
      "destination": "/pages/contact.html"
    },
    {
      "source": "/a-propos",
      "destination": "/pages/a-propos.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/pages/mentions-legales.html"
    },
    {
      "source": "/services/refonte-site-web",
      "destination": "/pages/services/refonte-site-web.html"
    },
    {
      "source": "/services/site-web",
      "destination": "/pages/services/site-web.html"
    },
    {
      "source": "/services/identite-marque",
      "destination": "/pages/services/identite-marque.html"
    },
    {
      "source": "/services/outil-metier",
      "destination": "/pages/services/outil-metier.html"
    },
    {
      "source": "/services/crm-dashboard",
      "destination": "/pages/services/crm-dashboard.html"
    },
    {
      "source": "/services/accompagnement",
      "destination": "/pages/services/accompagnement.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/main-(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).(png|jpg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/devis",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/pages/devis.html",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/pages/contact.html",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/pages/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/pages/a-propos.html",
      "destination": "/a-propos",
      "statusCode": 301
    },
    {
      "source": "/pages/mentions-legales.html",
      "destination": "/mentions-legales",
      "statusCode": 301
    },
    {
      "source": "/pages/agence-web-roissy-en-brie.html",
      "destination": "/agence-web-roissy-en-brie",
      "statusCode": 301
    },
    {
      "source": "/pages/agence-web-seine-et-marne.html",
      "destination": "/agence-web-seine-et-marne",
      "statusCode": 301
    },
    {
      "source": "/pages/guides/index.html",
      "destination": "/guides",
      "statusCode": 301
    },
    {
      "source": "/pages/guides/:slug.html",
      "destination": "/guides/:slug",
      "statusCode": 301
    },
    {
      "source": "/pages/services/:slug.html",
      "destination": "/services/:slug",
      "statusCode": 301
    },
    {
      "source": "/404.html",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
